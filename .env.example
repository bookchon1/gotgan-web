# 곳간 — Supabase 연결 (새 프로젝트)
# supabase.com에서 새 프로젝트 생성 후 Project Settings → API 에서 복사
# 이 파일(.env.example)은 키 '이름'만 담습니다. 실제 값은 .env 에 넣으세요(.env는 git 제외).

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ⚠️ service_role 키는 여기에도, 프런트엔드 어디에도 넣지 마세요.
#    (데이터 이관 등 서버 작업 시에만 로컬에서 별도 사용)
